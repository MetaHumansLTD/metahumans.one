FROM php:8.3-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip libzip-dev libxml2-dev libssl-dev \
    && docker-php-ext-install pdo pdo_mysql dom \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html/gear/domain-registrars

COPY composer.json ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist

COPY . .

RUN mkdir -p /var/www/html/var \
    && chmod +x /var/www/html/gear/domain-registrars/docker-entrypoint-mh.sh \
    && chmod +x bin/worker

ENTRYPOINT ["/var/www/html/gear/domain-registrars/docker-entrypoint-mh.sh"]
CMD ["php", "bin/worker"]
