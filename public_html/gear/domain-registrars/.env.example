APP_ENV=local
APP_DEBUG=true
APP_ROLE=hub
APP_URL=http://127.0.0.1:8080
HUB_ALLOW_LIVE_REGISTRATION=false
CONTROL_USERNAME=admin
CONTROL_PASSWORD=
WORKER_POLL_SECONDS=5
WORKER_RUN_ONCE=false
SHARED_DB_CONFIG_ID=db_domain_registrars_shared
TENANT_DB_CONFIG_ID=
TENANT_ID=user:local-demo
DOMAIN_OWNER_TYPE=
DOMAIN_OWNER_ID=
DOMAIN_BILLING_MODE=
DOMAIN_BILLING_TENANT_ID=
MH_AUTH_USER=
MH_PERSONA_ID=
CUE_BOOTSTRAP_PATH=
CUE_CONFIG_DIR=
CUE_TENANT_CONTEXTS_PATH=
CUE_TENANT_DB_CONFIG_IDS=

# Standalone fallback SQLite:
DB_DSN=sqlite:var/data/app.sqlite
# Standalone shared DB override:
# SHARED_DB_DSN=mysql:host=mariadb-service;port=3306;dbname=domainname_controller;charset=utf8mb4
# SHARED_DB_USER=domainname_controller
# SHARED_DB_PASSWORD=
# Standalone tenant DB override:
# TENANT_DB_DSN=mysql:host=mariadb-service;port=3306;dbname=tenant_example;charset=utf8mb4
# TENANT_DB_USER=tenant_example
# TENANT_DB_PASSWORD=
# Legacy single-DB fallback:
# DB_DSN=mysql:host=mariadb-service;port=3306;dbname=domainname_controller;charset=utf8mb4
DB_USER=
DB_PASSWORD=

COZA_HOST=epp.registry.example
COZA_PORT=700
COZA_USERNAME=
COZA_PASSWORD=
COZA_CERT_PATH=
COZA_CERT_PASSPHRASE=
COZA_CA_FILE=
COZA_VERIFY_PEER=true
COZA_TIMEOUT=30
COZA_CLIENT_ID=registrar-id
COZA_LOGIN_OBJECT_URIS=urn:ietf:params:xml:ns:domain-1.0,urn:ietf:params:xml:ns:contact-1.0,urn:ietf:params:xml:ns:host-1.0
COZA_LOGIN_EXTENSION_URIS=
COZA_PRICING_JSON=

NETEARTHONE_API_BASE_URL=https://httpapi.com/api
NETEARTHONE_AUTH_USER_ID=
NETEARTHONE_API_KEY=
NETEARTHONE_TIMEOUT=30
NETEARTHONE_DEFAULT_CUSTOMER_ID=
NETEARTHONE_DEFAULT_INVOICE_OPTION=NoInvoice
NETEARTHONE_PRICING_JSON=
