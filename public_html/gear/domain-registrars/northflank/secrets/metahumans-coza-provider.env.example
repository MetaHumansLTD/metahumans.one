COZA_HOST=epp.registry.example
COZA_PORT=700
COZA_USERNAME=
COZA_PASSWORD=
COZA_CLIENT_ID=
COZA_LOGIN_OBJECT_URIS=urn:ietf:params:xml:ns:domain-1.0,urn:ietf:params:xml:ns:contact-1.0,urn:ietf:params:xml:ns:host-1.0
COZA_LOGIN_EXTENSION_URIS=
COZA_VERIFY_PEER=true
COZA_TIMEOUT=30
COZA_CERT_PATH=/var/run/secrets/metahumans-coza-certificates/client.pem
COZA_CA_FILE=/var/run/secrets/metahumans-coza-certificates/ca.pem
COZA_PRICING_JSON=
